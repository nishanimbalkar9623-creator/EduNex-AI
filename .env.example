# Copy this file to .env and replace every value before use.
SECRET_KEY=replace-with-a-long-random-secret
# Generate hashes with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-password'))"
DEMO_RAHUL_PASSWORD=replace-with-rahul-password-hash
DEMO_SHARMA_PASSWORD=replace-with-sharma-password-hash
DEMO_PATIL_PASSWORD=replace-with-patil-password-hash
DEMO_DESHMUKH_PASSWORD=replace-with-deshmukh-password-hash
OLLAMA_BASE_URL=http://localhost:11434
